# API bridge base URL (Cloudflare Worker — RF_09 / TASK_GS_02)
# Local dev (recommended): leave empty — Vite proxies /api → http://127.0.0.1:8787 (no CORS).
# VITE_CBV_API_BASE_URL=
# Direct Worker URL (requires CBV_ALLOWED_ORIGINS; on Windows prefer 127.0.0.1 not localhost):
# VITE_CBV_API_BASE_URL=http://127.0.0.1:8787
# Disable Vite dev proxy when using direct Worker URL on a custom port:
# VITE_CBV_DEV_PROXY=false

# Real operational runtime (TASK_GS_02) — disables task mock when Worker connected
VITE_CBV_TASK_RUNTIME_MODE=google_sheet_existing_db

# Optional: test role against Worker auth stub (ADMIN|MANAGER|STAFF|FINANCE|HO_SO|VIEW_ONLY)
# VITE_CBV_ROLE=MANAGER

# AppSheet TASK_MAIN deep link (quote required — URL contains #)
# VITE_CBV_APPSHEET_TASK_URL="https://www.appsheet.com/start/...&view=TASK_MAIN"

# Developer operator UI (footer keyboard shortcut hints) — default off for operator runtime
# VITE_CBV_DEV_MODE=true

# Checklist local→Sheet migration panel (dev/admin only) — any one enables migration UI
# VITE_CBV_DEBUG_MODE=true
# VITE_CBV_ADMIN_TOOLS_ENABLED=true

# Frontend render performance debug (PHASE_TASK_GS_10C) — logs to console.debug when true
# VITE_CBV_RENDER_PERF_DEBUG=true

# Operational filter debug (PHASE_TASK_GS_10D) — logs filter derivation when true
# VITE_CBV_FILTER_DEBUG=true

# Work Inbox V3 group panel on /inbox (Phase C) — default on; set false to disable
# VITE_CBV_WORK_INBOX_GROUPS_V3=false

# Work Inbox V3 Focus Mode (Phase E) — default on when groups V3 enabled; set false to hide 🎯 Focus Mode
# VITE_CBV_WORK_INBOX_FOCUS_V3=false

# Runtime transition — V3 primary on /inbox (default on); set false for legacy-first fallback
# VITE_CBV_WORK_INBOX_V3_PRIMARY=false

# Runtime transition — show legacy cognition list panel (default on); set false to hide operator toggle
# VITE_CBV_LEGACY_TASK_RUNTIME=false

# OCMS Case Context Strip (PHASE_OCMS_03 / 03D) — default OFF; set true to render strip in Focus Mode
# VITE_OCMS_CASE_STRIP_ENABLED=true

# OCMS UAT session telemetry (PHASE_OCMS_03B) — sessionStorage only; requires strip flag ON
# VITE_OCMS_UAT_TELEMETRY=true

# Case Workspace — Case-centric focus layout (CASE_REFACTOR_03) — default OFF
# When ON: Case Header/Context/Checklist/Tasks/Docs/Timeline/Handoff; legacy layout when OFF
# VITE_CASE_WORKSPACE_ENABLED=true

# Case Workspace UAT telemetry (CASE_REFACTOR_04) — sessionStorage only; requires workspace ON
# VITE_CASE_WORKSPACE_UAT_TELEMETRY=true
